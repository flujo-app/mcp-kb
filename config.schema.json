{
  "$defs": {
    "BasicAuth": {
      "additionalProperties": false,
      "description": "Credentials for a remote that requires them: a git host, a WebDAV server.\n\nThe username is usually a literal -- GitHub wants ``x-access-token`` -- so\nit takes one. But a service account's name arrives in the same secret as\nits password, and writing it out here as well is how the two drift apart\nthe day the account is recreated, so it takes an ``{env:}`` reference too.",
      "properties": {
        "username": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvRef"
            },
            {
              "type": "string"
            }
          ],
          "title": "Username"
        },
        "password": {
          "$ref": "#/$defs/EnvRef"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "BasicAuth",
      "type": "object"
    },
    "EnvRef": {
      "additionalProperties": false,
      "description": "A secret named by the environment variable that holds it.",
      "properties": {
        "env": {
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvRef",
      "type": "object"
    },
    "LibraryConfig": {
      "additionalProperties": false,
      "description": "A library: a marketplace, plugins by name, or a query -- and their union.\n\nA library carries no tags and no category of its own. Tagging is what a\nplugin does, so ``?tags=`` reaches a library only through what its plugins\nsay, and the selector gets an unambiguous name of its own after\nKubernetes' ``selector``.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "plugins": {
          "items": {
            "type": "string"
          },
          "title": "Plugins",
          "type": "array"
        },
        "pluginSelector": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "LibraryConfig",
      "type": "object"
    },
    "PluginConfig": {
      "additionalProperties": false,
      "description": "A folder of skills and prompts: a path under a source, plus its metadata.\n\nThe metadata fields are Claude's marketplace-entry fields, so a plugin\ndeclared here and one read out of a ``marketplace.json`` carry the same\nshape and a selector cannot tell them apart. The glob lists are this\nserver's own: omitted, a kind falls to the plugin's manifest and then to\nthe conventions.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "skills": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skills"
        },
        "prompts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompts"
        },
        "files": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files"
        },
        "dialect": {
          "default": "auto",
          "enum": [
            "auto",
            "mcp-kb",
            "claude",
            "copilot"
          ],
          "title": "Dialect",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "PluginConfig",
      "type": "object"
    },
    "Selector": {
      "additionalProperties": false,
      "description": "A query over plugins: categories narrow first, then tag groups.\n\nAcross the two fields it is AND, as in every faceted search. Within\n``categories`` it can only be OR -- a plugin has exactly one category --\nand within ``tags`` a comma means *all of* while separate items mean *any\nof*, which is the same comma rule a request's ``?tags=`` carries.",
      "properties": {
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "Selector",
      "type": "object"
    },
    "SourceConfig": {
      "additionalProperties": false,
      "description": "A named backend: where bytes come from and how to log in, declared once.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/BasicAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cache": {
          "default": "snapshot",
          "enum": [
            "snapshot",
            "live"
          ],
          "title": "Cache",
          "type": "string"
        },
        "refresh": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*[smh]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "SourceConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole config file: the sources, the plugins under them, the libraries.",
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceConfig"
      },
      "title": "Sources",
      "type": "array"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/PluginConfig"
      },
      "title": "Plugins",
      "type": "array"
    },
    "libraries": {
      "items": {
        "$ref": "#/$defs/LibraryConfig"
      },
      "title": "Libraries",
      "type": "array"
    }
  },
  "title": "Config",
  "type": "object"
}
