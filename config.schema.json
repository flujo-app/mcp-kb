{
  "$defs": {
    "BasicAuth": {
      "additionalProperties": false,
      "description": "Credentials for a git remote that requires them.",
      "properties": {
        "username": {
          "title": "Username",
          "type": "string"
        },
        "password": {
          "$ref": "#/$defs/EnvRef"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "BasicAuth",
      "type": "object"
    },
    "EnvRef": {
      "additionalProperties": false,
      "description": "A secret named by the environment variable that holds it.",
      "properties": {
        "env": {
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvRef",
      "type": "object"
    },
    "FileSource": {
      "additionalProperties": false,
      "description": "A directory on this machine, served in place.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "library": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "include": {
          "$ref": "#/$defs/Include",
          "default": {
            "skills": null,
            "prompts": null,
            "instructions": null,
            "agents": null,
            "files": null
          }
        },
        "refresh": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*[smh]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "FileSource",
      "type": "object"
    },
    "GitSource": {
      "additionalProperties": false,
      "description": "A git repository, cloned bare and shallow, exported at a ref.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "library": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "include": {
          "$ref": "#/$defs/Include",
          "default": {
            "skills": null,
            "prompts": null,
            "instructions": null,
            "agents": null,
            "files": null
          }
        },
        "refresh": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*[smh]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "subdirectory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subdirectory"
        },
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/BasicAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "GitSource",
      "type": "object"
    },
    "Include": {
      "additionalProperties": false,
      "description": "Globs per kind, relative to the source root. None means the conventions.",
      "properties": {
        "skills": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skills"
        },
        "prompts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompts"
        },
        "instructions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "agents": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agents"
        },
        "files": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files"
        }
      },
      "title": "Include",
      "type": "object"
    },
    "Library": {
      "additionalProperties": false,
      "description": "A named grouping several sources can join, carrying its own tags.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Library",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole config file: the libraries declared and the sources that join them.",
  "properties": {
    "libraries": {
      "items": {
        "$ref": "#/$defs/Library"
      },
      "title": "Libraries",
      "type": "array"
    },
    "sources": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/FileSource"
          },
          {
            "$ref": "#/$defs/GitSource"
          }
        ]
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "title": "Config",
  "type": "object"
}
